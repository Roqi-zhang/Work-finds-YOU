<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=1280" />
<title>04 Compare · Orbit Pool · A</title>
<link rel="stylesheet" href="./_shared.css" />
<script src="./_shared.js"></script>
<style>
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; }
  .head-row h1 { font-size: 72px; font-weight: 500; letter-spacing: -0.035em; line-height: 0.92; color: var(--ink-strong); }
  .head-row .caption { max-width: 32ch; opacity: .7; text-transform: none; letter-spacing: 0.02em; font-size: 13px; }

  .stage { display: grid; grid-template-columns: 8fr 4fr; gap: 32px; height: 640px; }
  .pool {
    position: relative;
    border: 0.5px solid var(--line);
    overflow: hidden;
    background: var(--paper);
  }
  .pool svg { display: block; width: 100%; height: 100%; }
  .pool .ring { fill: none; stroke: var(--line); stroke-width: 0.5; }
  .pool .center {
    fill: var(--paper); stroke: var(--ink-strong); stroke-width: 0.5;
  }
  .pool .center-label { font-size: 11px; fill: var(--ink-strong); text-anchor: middle; letter-spacing: 0.02em; }
  .pool .center-sub { font-size: 10px; fill: var(--ink); text-anchor: middle; letter-spacing: 0.22em; text-transform: uppercase; opacity: .55; font-family: "JetBrains Mono", ui-monospace, monospace; }

  .node {
    fill: var(--paper); stroke: var(--ink); stroke-width: 0.5;
    cursor: pointer; transition: all .4s var(--ease);
  }
  .node:hover, .node.active { fill: var(--ink-strong); stroke: var(--ink-strong); r: 12; }
  .node-label { font-size: 10px; fill: var(--ink); font-family: "JetBrains Mono", ui-monospace, monospace; letter-spacing: 0.08em; }

  .bezier { fill: none; stroke: var(--ink-strong); stroke-width: 0.75; stroke-dasharray: 2 3; opacity: 0; transition: opacity .4s var(--ease); }
  .bezier.on { opacity: 1; }

  /* right side detail */
  .detail {
    display: flex; flex-direction: column; gap: 22px;
    padding: 24px; border: 0.5px solid var(--line);
    background: var(--paper);
  }
  .detail .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; opacity: .55; }
  .detail h3 { font-size: 32px; font-weight: 500; letter-spacing: -0.02em; color: var(--ink-strong); line-height: 1; }
  .detail .meta { display: flex; gap: 16px; font-size: 12px; opacity: .75; }
  .detail .row { display: flex; justify-content: space-between; border-top: 0.5px solid var(--line); padding-top: 10px; font-size: 13px; }
  .detail .actions { display: flex; gap: 12px; margin-top: 12px; }
  .btn { border: 0.5px solid var(--ink); padding: 10px 18px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; border-radius: 999px; transition: all .3s var(--ease); }
  .btn:hover { background: var(--ink-strong); color: var(--paper); }
  .btn.ghost { border-color: var(--line); }

  /* controls */
  .controls {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 32px; padding: 20px 0; border-top: 0.5px solid var(--line); border-bottom: 0.5px solid var(--line);
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  }
  .controls .grp { display: flex; gap: 24px; align-items: center; }
  .controls .grp button { opacity: .5; transition: opacity .3s var(--ease); position: relative; padding: 4px 0; }
  .controls .grp button.on, .controls .grp button:hover { opacity: 1; color: var(--ink-strong); }
  .controls .grp button.on::after { content:""; position: absolute; left:0; right:0; bottom: -4px; height: 0.5px; background: var(--ink-strong); }
</style>
</head>
<body>
<main class="page">
  <header class="topbar">
    <div class="logo">Work Finds You / 工作找你</div>
    <nav>
      <a href="./home.html">01 Home</a>
      <a href="./profile.html">02 Profile</a>
      <a href="./jobprofile.html">03 Job</a>
      <a href="./match.html">04 Match</a>
      <a href="./compare.html" class="on">05 Compare</a>
      <a href="./delivery.html">06 Delivery</a>
    </nav>
    <div class="right">
      <span class="caption">Pool · 12 jobs</span>
      <button class="theme-toggle"></button>
    </div>
  </header>

  <div class="head-row">
    <div>
      <div class="caption">04 · Compare</div>
      <h1 style="margin-top:16px;">Orbit<br/>the pool.</h1>
    </div>
    <p class="caption">中心是你的画像，同心轨道上分布 12 个岗位节点。悬停任意节点，中心与它之间生成贝塞尔连线，右侧面板同步显示 Why Yes / Why No / Match。</p>
  </div>

  <section class="stage">
    <div class="pool">
      <svg viewBox="-400 -320 800 640" id="orbit">
        <circle class="ring" r="140" />
        <circle class="ring" r="220" />
        <circle class="ring" r="290" />

        <!-- center candidate -->
        <circle class="center" r="52" />
        <text class="center-label" y="-2">YOU · L. HAN</text>
        <text class="center-sub" y="16">Match core</text>

        <!-- bezier overlay -->
        <path id="line" class="bezier" d="M0,0 C0,0 0,0 0,0" />

        <!-- nodes generated by JS -->
        <g id="nodes"></g>
      </svg>
    </div>

    <aside class="detail" id="detail">
      <div class="k">04 / 12 · Selected</div>
      <div>
        <h3 id="d-title">Senior Frontend</h3>
        <div class="meta">
          <span id="d-company">Stripe</span>
          <span>·</span>
          <span id="d-loc">Remote / SF</span>
        </div>
      </div>
      <div class="row"><span>Match</span><span id="d-match">78%</span></div>
      <div class="row"><span>Salary</span><span id="d-salary">$180K–220K</span></div>
      <div class="row"><span>Why Yes</span><span id="d-yes">Craft · Product</span></div>
      <div class="row"><span>Why No</span><span id="d-no">Team &gt; 60</span></div>
      <div class="actions">
        <a class="btn" href="./match.html">查看匹配 →</a>
        <button class="btn ghost">移出对比</button>
      </div>

      <div style="margin-top:auto; padding-top:16px; border-top: 0.5px solid var(--line);">
        <div class="k" style="margin-bottom:8px;">Pool loading</div>
        <div class="moon"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
    </aside>
  </section>

  <div class="controls">
    <div class="grp">
      <span class="caption">Sort</span>
      <button class="on">Match</button>
      <button>Salary</button>
      <button>Recency</button>
    </div>
    <div class="grp">
      <span class="caption">Orbits</span>
      <button>2</button>
      <button class="on">3</button>
      <button>4</button>
    </div>
    <div class="grp">
      <span class="caption">Density</span>
      <button>Sparse</button>
      <button class="on">Regular</button>
      <button>Dense</button>
    </div>
  </div>
</main>
<a class="preview-crumb" href="./index.html">← Previews</a>

<script>
  const jobs = [
    { r: 140, a: -30,  title: "Senior Frontend",  co: "Stripe",   loc: "Remote / SF",  m: 78, s: "$180K–220K", yes: "Craft · Product", no: "Team > 60" },
    { r: 140, a: 90,   title: "Design Engineer",  co: "Linear",   loc: "Remote",       m: 84, s: "$170K–210K", yes: "Craft · Speed",   no: "Small team OK" },
    { r: 140, a: 210,  title: "Web Platform",     co: "Vercel",   loc: "Hybrid NYC",   m: 72, s: "$160K–200K", yes: "Perf",            no: "Hybrid required" },
    { r: 220, a: 20,   title: "Staff FE",         co: "Notion",   loc: "Remote",       m: 68, s: "$210K–260K", yes: "Editor systems",  no: "Long tenure need" },
    { r: 220, a: 80,   title: "Frontend Lead",    co: "Figma",    loc: "SF",           m: 74, s: "$220K–270K", yes: "Design tools",    no: "Onsite" },
    { r: 220, a: 160,  title: "UI Systems",       co: "Retool",   loc: "Remote",       m: 66, s: "$150K–190K", yes: "Design system",   no: "B2B focus" },
    { r: 220, a: 240,  title: "Product Eng",      co: "Raycast",  loc: "Remote EU",    m: 81, s: "€120K–160K", yes: "Product craft",   no: "Time zone" },
    { r: 220, a: 320,  title: "FE / DX",          co: "Warp",     loc: "SF",           m: 63, s: "$170K–210K", yes: "DX focus",        no: "Onsite" },
    { r: 290, a: 0,    title: "Frontend Arch",    co: "Databricks",loc: "Remote",      m: 59, s: "$230K–290K", yes: "Data UI",         no: "Enterprise" },
    { r: 290, a: 60,   title: "Web Eng",          co: "OpenAI",   loc: "SF",           m: 71, s: "$220K–260K", yes: "Cutting edge",    no: "Onsite" },
    { r: 290, a: 140,  title: "UI Engineer",      co: "Anthropic",loc: "Remote",       m: 76, s: "$210K–250K", yes: "Research UI",     no: "Sec review" },
    { r: 290, a: 220,  title: "Senior Web",       co: "Cloudflare",loc: "Remote",      m: 64, s: "$180K–220K", yes: "Edge platform",   no: "Legacy code" },
  ];

  // ---- merge locally added jobs (from match.html「加入对比」) ----
  (function () {
    let pool = [];
    try { pool = JSON.parse(localStorage.getItem("wfy.pool") || "[]"); } catch (e) { pool = []; }
    pool.forEach((p, n) => {
      if (jobs.some((j) => j.co === p.co && j.title === p.title)) return;
      jobs.push({
        r: 290, a: 280 + n * 24, title: p.title, co: p.co, loc: p.loc || "—",
        m: p.m || 0, s: p.s || "—", yes: p.yes || "刚加入对比", no: p.no || "—",
      });
    });
  })();



  const nodes = document.getElementById("nodes");
  const line = document.getElementById("line");
  const detail = {
    title: document.getElementById("d-title"),
    company: document.getElementById("d-company"),
    loc: document.getElementById("d-loc"),
    match: document.getElementById("d-match"),
    salary: document.getElementById("d-salary"),
    yes: document.getElementById("d-yes"),
    no: document.getElementById("d-no"),
    k: document.querySelector("#detail .k"),
  };

  jobs.forEach((j, i) => {
    const rad = (j.a * Math.PI) / 180;
    const x = Math.cos(rad) * j.r;
    const y = Math.sin(rad) * j.r;
    const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
    g.setAttribute("transform", `translate(${x} ${y})`);
    const c = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    c.setAttribute("class", "node" + (i === 0 ? " active" : ""));
    c.setAttribute("r", "8");
    c.dataset.i = i;
    c.dataset.x = x;
    c.dataset.y = y;
    g.appendChild(c);
    const t = document.createElementNS("http://www.w3.org/2000/svg", "text");
    t.setAttribute("class", "node-label");
    t.setAttribute("x", "14");
    t.setAttribute("y", "4");
    t.textContent = j.co.toUpperCase();
    g.appendChild(t);
    nodes.appendChild(g);

    c.addEventListener("mouseenter", () => activate(i, x, y));
    c.addEventListener("click", () => activate(i, x, y));
  });

  function activate(i, x, y) {
    document.querySelectorAll(".node").forEach(n => n.classList.remove("active"));
    document.querySelectorAll(".node")[i].classList.add("active");
    // bezier from (0,0) with curved control points
    const cx = x * 0.35, cy = y * 0.35 - 60 * Math.sign(y || 1);
    line.setAttribute("d", `M 0 0 C ${cx} ${cy}, ${x - cx} ${y - cy}, ${x} ${y}`);
    line.classList.add("on");
    const j = jobs[i];
    detail.k.textContent = `${String(i+1).padStart(2,"0")} / ${jobs.length} · Selected`;
    detail.title.textContent = j.title;
    detail.company.textContent = j.co;
    detail.loc.textContent = j.loc;
    detail.match.textContent = j.m + "%";
    detail.salary.textContent = j.s;
    detail.yes.textContent = j.yes;
    detail.no.textContent = j.no;
  }
  // activate the job just added from the match page, otherwise the first one
  const focus = localStorage.getItem("wfy.focus");
  let start = 0;
  if (focus) {
    const slug = (j) => (j.co + "-" + j.title).toLowerCase().replace(/\s+/g, "-");
    const k = jobs.findIndex((j) => slug(j) === focus);
    if (k >= 0) start = k;
    localStorage.removeItem("wfy.focus");
  }
  const first = jobs[start];
  activate(start, Math.cos(first.a * Math.PI/180) * first.r, Math.sin(first.a * Math.PI/180) * first.r);

</script>
</body>
</html>
